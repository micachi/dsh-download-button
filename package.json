{
  "name": "dsh-download-button",
  "version": "0.1.0",
  "description": "Adds a download button to delivered files and to the right-Sidebar document preview in the DeepSeek Harness Web GUI.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micachi/dsh-download-button.git"
  },
  "homepage": "https://github.com/micachi/dsh-download-button#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "download"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-deliverables",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  }
}
